# Local runs should load Alpaca credentials from Azure Key Vault.
# Run `az login` first, then point the app at the right vault.
AZURE_KEY_VAULT_NAME=spectral-nature-kvault
KEY_VAULT_NAME=spectral-nature-kvault
# Optional secret-name overrides. Defaults are shown here for clarity.
APCA_API_KEY_SECRET_NAME=apca-api-key
APCA_API_SECRET_KEY_SECRET_NAME=apca-api-secret-key
APCA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Optional admin security panel overrides for Azure audit/diagnostic inspection.
# These default to the current shared Spectral Nature resources when omitted.
# ADMIN_SECURITY_SUBSCRIPTION_ID=
# ADMIN_SECURITY_RESOURCE_GROUP=spectral-nature-2
# ADMIN_SECURITY_SQL_SERVER=spectral-nature-server
# ADMIN_SECURITY_SQL_DATABASES=spectral-nature-db,master
# ADMIN_SECURITY_KEY_VAULT_NAME=spectral-nature-kvault
# ADMIN_SECURITY_LOG_ANALYTICS_WORKSPACE_ID=

# Auth + public URL
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_MODE=database
APP_PUBLIC_BASE_URL=http://localhost:8501
# Browser session persistence is ON by default (cookie survives page reloads and restarts).
# To disable: UI_DISABLE_BROWSER_SESSION_COOKIE=1
# Remember-me TTL defaults to 30 days; regular session TTL defaults to 7 days.
# AUTH_REMEMBER_ME_TTL_SECONDS=2592000
# AUTH_SESSION_TTL_SECONDS=604800
# API_ALLOW_LEGACY_SESSION_BEARER=1

# Email delivery
APP_SMTP_HOST=smtp.azurecomm.net
APP_SMTP_PORT=587
APP_SMTP_USE_TLS=true
APP_SMTP_USE_SSL=false
# Optional for local-only testing without Key Vault:
# APP_SMTP_USERNAME=your_smtp_username
# APP_SMTP_PASSWORD=your_smtp_password
# APP_EMAIL_FROM=noreply@example.com

# Optional secret-name overrides when running against Key Vault.
# The app defaults to:
# APP_SMTP_USERNAME_SECRET=app-smtp-username
# APP_SMTP_PASSWORD_SECRET=app-smtp-password
# APP_EMAIL_FROM_SECRET=app-email-from

# LLM runtime for Zopedia/AQL and shared analysis surfaces
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-reasoner
LLM_BASE_URL=https://api.deepseek.com
# Prefer loading the API key from Key Vault. The shared deployment defaults to:
# LLM_API_KEY_SECRET_NAME=deepseek-api-key
# Optional overrides:
# LLM_TIMEOUT_SECONDS=60
# LLM_TEMPERATURE=0.2
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ElevenLabs audio summary
# Used by the homepage UI and the attention-home-build job for prebuilt narration.
# Prefer loading these from Key Vault. The app defaults to:
# ELEVENLABS_API_KEY_SECRET_NAME=elevenlabs-api-key
# ELEVENLABS_VOICE_ID_SECRET_NAME=elevenlabs-voice-id
# Optional direct local-only fallbacks:
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_VOICE_ID=your_voice_id
# Optional overrides:
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Seeking Alpha page access
# Prefer loading these from Key Vault. The defaults are:
# SEEKING_ALPHA_USERNAME_SECRET_NAME=seeking-alpha-username
# SEEKING_ALPHA_PASSWORD_SECRET_NAME=seeking-alpha-password
# Optional direct local-only fallbacks:
# SEEKING_ALPHA_USERNAME=your_seeking_alpha_username
# SEEKING_ALPHA_PASSWORD=your_seeking_alpha_password
# Optional runtime tuning:
# SEEKING_ALPHA_BROWSER_HEADLESS=true
# SEEKING_ALPHA_BROWSER_WAIT_MS=2000
# ATTENTION_HOME_SEEKING_ALPHA_PAGE_LIMIT=2
# ATTENTION_HOME_SEEKING_ALPHA_PAGE_MAX_CHARS=12000
# ATTENTION_HOME_PAGE_ENRICH_LIMIT=4
# ATTENTION_HOME_PAGE_ENRICH_MAX_CHARS=12000
# ATTENTION_HOME_PAGE_ENRICH_MIN_TEXT_CHARS=220
# TAVILY_INCLUDE_RAW_CONTENT=true

# Pipeline-store local cache guardrails
# Local pipeline_store cache is best-effort only. It is rebuilt from blob storage when cold.
# Default cap is 256 MiB if unset.
# PIPELINE_CACHE_MAX_BYTES=268435456
# PIPELINE_METADATA_CACHE_SECONDS=30
