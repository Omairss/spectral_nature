# Local runs should load Alpaca credentials from Azure Key Vault.
# Run `az login` first, then point the app at the right vault.
AZURE_KEY_VAULT_NAME=spectral-nature-kvault
KEY_VAULT_NAME=spectral-nature-kvault
# Optional secret-name overrides. Defaults are shown here for clarity.
APCA_API_KEY_SECRET_NAME=apca-api-key
APCA_API_SECRET_KEY_SECRET_NAME=apca-api-secret-key
APCA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Auth + public URL
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_MODE=database
APP_PUBLIC_BASE_URL=http://localhost:8501

# Email delivery
APP_SMTP_HOST=smtp.azurecomm.net
APP_SMTP_PORT=587
APP_SMTP_USE_TLS=true
APP_SMTP_USE_SSL=false
# Optional for local-only testing without Key Vault:
# APP_SMTP_USERNAME=your_smtp_username
# APP_SMTP_PASSWORD=your_smtp_password
# APP_EMAIL_FROM=noreply@example.com

# Optional secret-name overrides when running against Key Vault.
# The app defaults to:
# APP_SMTP_USERNAME_SECRET=app-smtp-username
# APP_SMTP_PASSWORD_SECRET=app-smtp-password
# APP_EMAIL_FROM_SECRET=app-email-from
