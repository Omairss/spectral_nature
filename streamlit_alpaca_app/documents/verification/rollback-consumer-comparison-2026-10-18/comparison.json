  "findings": [
    {
      "name": "Database admission and cancellation are absent from all four retained images",
      "affected_jobs": [
        "universe-builder",
        "fundamentals-quarterly-refresh",
        "system-health",
        "robinhood-main-sync-prod"
      ],
      "basis": "Direct psycopg.connect in the dispatched main connection owner or broker auth_store._db_connect; neither services/database.py nor services/work_scope.py exists in the images.",
      "impact": "These clients bypass the shared transaction permits and work-scope cancellation; protected interactive concurrency is therefore not enforced across every participating producer. CPU impact is not measured."
    },
    {
      "name": "Universe and fundamentals retain older publication and completion paths",
      "affected_jobs": [
        "universe-builder",
        "fundamentals-quarterly-refresh"
      ],
      "basis": "_upload_manifest overwrites latest.json directly; _persist_dataset propagates SQL-index failure after the Blob write; main lacks durable job completion receipt.",
      "impact": "They lack conditional advancement of the latest pointer and explicit recovery/Warning handling for SQL-index failure after a committed Blob publication."
    },
    {
      "name": "Scheduled health retains SQL-dependent metadata reads and older completion handling",
      "affected_jobs": [
        "system-health"
      ],
      "basis": "services/system_health.py and services/emailer.py match the accepted code, but imported pipeline_store.latest_dataset_metadata still reads SQL on a cold metadata miss even when the stable Blob manifest is present; main has raw database connections and no durable completion receipt.",
      "impact": "Monitoring coverage is preserved, while observation still adds avoidable SQL dependency and lacks the newer completion outbox."
    },
    {
      "name": "Production recovery entrypoint has no configured production job",
      "affected_jobs": [
        "system-health"
      ],
      "basis": "The only accepted runtime call sites for the manifest and provider-receipt reconcilers are run_system_recovery; the only live job binding is manual system-recovery-dev with namespace development.",
      "impact": "Production has no configured periodic executor for the new bounded recovery entrypoint. This does not establish a count of pending receipts or lost publications."
    },
    {
      "name": "Broker upgrade also requires explicit background workload scope",
      "affected_jobs": [
        "robinhood-main-sync-prod"
      ],
      "basis": "The accepted broker script and its stores contain no database_workload scope; the accepted Dockerfile broker stage and current ARM environment set no PIPELINE_JOB_NAME. services.database._workload defaults such a process to interactive.",
      "impact": "Replacing only the broker image with the current accepted source would add managed connections but would classify scheduled sync work as interactive."
    }
  ],
  "excluded_from_feature_loss_claims": [
    "Uncalled Home/Trading/research/UI implementations present in older worker trees",
    "New API-only portfolio_data_status helper absent from the broker worker",
    "New downstream fundamental_snapshots_by_symbol helper absent from the fundamentals producer; its existing producer/loaders are preserved",
    "Missing news/calendar helpers unused by these job dispatch paths"
  ],
  "scope_limit": "Complete code and deployment-wiring comparison of these four jobs; no new product workflow, broker action, SQL stress load, LLM evaluation or production deployment. Does not certify repository-wide feature equivalence or current database utilization."
