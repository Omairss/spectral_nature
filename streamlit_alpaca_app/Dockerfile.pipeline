FROM python:3.11-slim

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV GIT_SHA=$SOURCE_REVISION

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
RUN python -m playwright install --with-deps chromium

COPY api ./api
COPY compute ./compute
COPY config ./config
COPY data ./data
COPY data_access ./data_access
COPY pipeline ./pipeline
COPY presentation ./presentation
COPY services ./services
COPY views ./views
COPY branding ./branding
COPY app.py ./app.py
COPY .streamlit/config.toml ./.streamlit/config.toml
COPY requirements.txt requirements-ui.lock ./
COPY scripts/collect_historical_corpus.py ./scripts/collect_historical_corpus.py
COPY cache/cache_policy.json ./cache/cache_policy.json
COPY scripts/sync_robinhood_main.py ./scripts/sync_robinhood_main.py

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

RUN python -c "import pipeline.jobs.main; from services.agents.research_session import ResearchBudget; budget = ResearchBudget.start(300, 90); assert budget.remaining() > 0; assert budget.step_deadline('synthesis', 5) > 0; assert budget.metadata()['elapsed_seconds'] >= 0"

CMD ["python", "-m", "pipeline.jobs.main"]
