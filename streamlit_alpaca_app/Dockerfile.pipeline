FROM python:3.11-slim

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV GIT_SHA=$SOURCE_REVISION

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
RUN python -m playwright install --with-deps chromium

COPY compute ./compute
COPY data_access ./data_access
COPY services ./services
COPY pipeline ./pipeline
COPY data ./data

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

RUN python -c "import pipeline.jobs.main; from services.agents.research_session import ResearchBudget; budget = ResearchBudget.start(300, 90); assert budget.remaining() > 0; assert budget.step_deadline('synthesis', 5) > 0; assert budget.metadata()['elapsed_seconds'] >= 0"

CMD ["python", "-m", "pipeline.jobs.main"]
