ARG BASE_IMAGE=snpipelineacr03130136.azurecr.io/database-lifecycle-dev-broker@sha256:94715ea21911b1441f67cde8dc03d640386adf14453c66df66ba225ea96e5941
FROM ${BASE_IMAGE}

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV GIT_SHA=$SOURCE_REVISION PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
RUN rm -rf /app && mkdir /app
WORKDIR /app
COPY . .

ENTRYPOINT []
CMD ["python", "/app/scripts/sync_robinhood_main.py", "--schedule-due", "--limit", "1"]
